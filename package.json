{
  "name": "snapbooth-rp203",
  "version": "1.0.0",
  "description": "SnapBooth photo booth app with RP203 thermal printer support (Windows & Mac)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "install-driver": "install_drivers.bat",
    "install-driver:win": "install_drivers.bat",
    "install-driver:mac": "brew install --cask wch-ch34x-usb-serial-driver",
    "download-models": "download_models.bat",
    "open": "cmd /c start index.html",
    "test-printer": "node printer_test.js",
    "calibrate-printer": "node printer_calibrate.js 5v"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@point-of-sale/receipt-printer-encoder": "^4.0.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jimp": "^0.22.10",
    "serialport": "^12.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "photo-booth",
    "thermal-printer",
    "rp203",
    "escpos",
    "windows",
    "ch340"
  ],
  "author": "SnapBooth",
  "license": "MIT"
}
